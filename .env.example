# --- Postgres (used by docker-compose) ---
POSTGRES_DB=paytrack
POSTGRES_USER=paytrack
POSTGRES_PASSWORD=paytrack

# --- Object storage for invoice PDFs (S3-compatible). Local dev runs LocalStack's S3 service
# via docker-compose since MinIO's own images now require an authenticated pull; point this at
# real MinIO or AWS S3 in any environment where that's available - the backend code is unchanged. ---
MINIO_ROOT_USER=paytrack
MINIO_ROOT_PASSWORD=paytrack123
MINIO_ENDPOINT=http://localhost:4566
MINIO_BUCKET=paytrack-invoices

# --- JWT ---
JWT_SECRET=change-me-to-a-long-random-base64-secret-at-least-256-bits
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14

# --- Encryption key for Google OAuth tokens at rest ---
TOKEN_ENCRYPTION_KEY=change-me-to-another-long-random-secret

# --- SMTP (MailHog locally, real SMTP in prod) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=noreply@paytrack.local

# --- Razorpay (test/sandbox keys from the Razorpay dashboard) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Google OAuth (Calendar API, from Google Cloud Console) ---
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_REDIRECT_URI=http://localhost:8080/api/integrations/google/callback

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080/api
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
